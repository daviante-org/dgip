# ==============================================================================
# DGIP Environment Configuration (.env)
# Used by Docker Compose (`docker compose`) and Podman Compose (`podman compose`)
# ==============================================================================

# PostgreSQL connection URI and async connection pool bounds
DGIP_DATABASE_URL=postgresql://dgip:change-me@postgres:5432/dgip
DGIP_DB_POOL_MIN_SIZE=2
DGIP_DB_POOL_MAX_SIZE=16

# Password used by the bundled PostgreSQL service in compose.yaml
POSTGRES_PASSWORD=change-me

# HTTP bind address and host-published port
DGIP_HOST=0.0.0.0
DGIP_PORT=8090

# Enable (`true`) or disable (`false`) the Daviante-branded Swagger UI (/docs) and /openapi.json
DGIP_SWAGGER_ENABLED=true

# Ephemeral local cache directory hydrated from PostgreSQL BYTEA snapshot storage
DGIP_CACHE_DIR=/tmp/dgip-cache

# Seeded into dgip_config strictly once when starting against an empty PostgreSQL database
DGIP_INITIAL_BOOTSTRAP_URL=https://github.com/daviante-org/dgip-data/releases/latest/download/bundle.tar.gz
DGIP_INITIAL_SNAPSHOT_RETENTION=5

# Comma-separated allowed CORS origins (or `*` for public lookup APIs)
DGIP_CORS_ALLOW_ORIGINS=*
